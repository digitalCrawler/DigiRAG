# ====================================================================
# DigiRAG Platform - Environment Variables Template
# ====================================================================
# In ASP.NET Core, nested JSON configurations are mapped using double underscores (__)
# Copy this file to .env or paste these keys into Railway / Render / Azure / Docker

# --- Runtime Environment ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
PORT=5000

# --- Database (PostgreSQL with pgvector) ---
# Example for local: Host=localhost;Port=5432;Database=digirag_db;Username=postgres;Password=postgres;
# Example for Railway/Supabase/Neon: Host=xxx.railway.internal;Port=5432;Database=railway;Username=postgres;Password=xxx;
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=digirag_db;Username=postgres;Password=postgres;Include Error Detail=true;

# --- Storage Configuration ---
# App_Data/Storage for local disk, or S3 bucket path
Storage__LocalPath=App_Data/Storage

# --- AI Provider Selection ---
# Options: Local | Gemini | OpenAI | AzureOpenAI
AiSettings__ActiveProvider=Gemini

# --- 1. Google Gemini Configuration (Recommended for Fast & Affordable Hosted RAG) ---
AiSettings__Gemini__ApiKey=AIzaSyYourGeminiApiKeyHere
AiSettings__Gemini__ChatModel=gemini-1.5-flash
AiSettings__Gemini__EmbeddingModel=text-embedding-004
AiSettings__Gemini__EmbeddingDimensions=768

# --- 2. OpenAI Configuration ---
AiSettings__OpenAI__ApiKey=sk-proj-YourOpenAiApiKeyHere
AiSettings__OpenAI__ChatModel=gpt-4o-mini
AiSettings__OpenAI__EmbeddingModel=text-embedding-3-small
AiSettings__OpenAI__EmbeddingDimensions=1536

# --- 3. Azure OpenAI Configuration ---
AiSettings__AzureOpenAI__Endpoint=https://your-resource.openai.azure.com/
AiSettings__AzureOpenAI__ApiKey=your-azure-api-key
AiSettings__AzureOpenAI__ChatDeploymentName=gpt-4o-mini
AiSettings__AzureOpenAI__EmbeddingDeploymentName=text-embedding-3-small
AiSettings__AzureOpenAI__EmbeddingDimensions=1536

# --- 4. Local Model Configuration (Ollama / Self-Hosted) ---
AiSettings__Local__Endpoint=http://localhost:11434
AiSettings__Local__ChatModel=llama3.2
AiSettings__Local__EmbeddingModel=nomic-embed-text
AiSettings__Local__EmbeddingDimensions=768

# --- CORS Allowed Origins (Comma-separated frontend URLs) ---
# Add your Vercel frontend URL here, e.g.: https://digirag.vercel.app
Cors__AllowedOrigins=http://localhost:4200,https://your-app.vercel.app
